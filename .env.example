# Copy to .env and adjust. Never commit the real .env file.
#
# This benchmark uses ONLY local models served by vLLM. The OpenAI-compatible
# client talks to vLLM with a dummy API key -- never set a real ANTHROPIC_API_KEY
# or OPENAI_API_KEY here or in your shell environment.

# Base URL of the local vLLM OpenAI-compatible server.
CMBENCH_VLLM_BASE_URL=http://localhost:8000/v1

# Dummy key: vLLM does not check it, but the openai SDK requires a non-empty value.
CMBENCH_VLLM_API_KEY=EMPTY

# SQLite database path used by the MCP server and the task graders.
CMBENCH_DB_PATH=./data/crm.db

# Directory where raw JSONL results and traces are written.
CMBENCH_RESULTS_DIR=./results

# Estimated GPU cost, in USD per hour, used only to label estimated run cost.
CMBENCH_GPU_HOURLY_USD=0.50
